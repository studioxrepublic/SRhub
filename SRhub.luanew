local HttpService = game:GetService("HttpService")
local function _decode(b) return HttpService:Base64Decode(b) end

local _panel_b64 = ""
local _rest_b64  = ""

local _panel = _decode(_panel_b64)
local _rest  = _decode(_rest_b64)

local f1 = assert(loadstring(_panel, "panel"))
local f2 = assert(loadstring(_rest,  "main"))

local ok, err = pcall(f1)
if not ok then warn("[panel] " .. tostring(err)) end
ok, err = pcall(f2)
if not ok then warn("[main] " .. tostring(err)) end
